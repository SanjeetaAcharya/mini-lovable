# Backend
PORT=4000
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
CLIENT_URL=http://localhost:5173

# Single hardcoded user — no auth in this build.
# Run `npx prisma db seed` and use the id it prints.
DEMO_USER_ID=

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
# Printed by `stripe listen --forward-to localhost:4000/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# Vercel deployment
# Create at https://vercel.com/account/tokens
VERCEL_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx