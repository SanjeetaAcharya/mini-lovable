# Backend
PORT=4000
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Origin of the deployed frontend — used for Stripe Checkout's
# success/cancel redirect AND as the allowed CORS origin. Locally this is
# the Vite dev server; in production it's the Vercel URL, no trailing
# slash (e.g. https://mini-lovable.vercel.app).
CLIENT_URL=http://localhost:5173

# Single hardcoded user — no auth in this build.
# Run `npx prisma db seed` and use the id it prints.
DEMO_USER_ID=

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
# Locally: printed by `stripe listen --forward-to localhost:4000/api/webhook`.
# In production: the signing secret from the real webhook endpoint
# registered in the Stripe dashboard (or via the API) against the
# deployed API's own /api/webhook URL — a different secret than the one
# `stripe listen` prints, because it's a different (real) endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# Vercel deployment
# Create at https://vercel.com/account/tokens
VERCEL_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx