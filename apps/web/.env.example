# Left unset for local dev — requests to /api/... stay relative and the
# Vite dev server proxies them to localhost:4000 (see vite.config.ts).
#
# Set in production (as a Vercel project env var, so it's baked in at
# build time): the deployed API's origin, no trailing slash, no /api
# suffix.
VITE_API_URL=https://mini-lovable-api.onrender.com
